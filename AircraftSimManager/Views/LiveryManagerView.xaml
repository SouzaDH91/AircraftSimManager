<UserControl x:Class="AircraftSimManager.Views.LiveryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:AircraftSimManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1100"
             AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Topo: Seletor de Simulador -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{helpers:Loc SimulatorSelectText}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="White"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Simulators}" SelectedItem="{Binding SelectedSimulator}" DisplayMemberPath="Name" Padding="6,4"/>
        </Grid>

        <!-- Caminho da pasta -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{helpers:Loc PathSim}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
            <TextBox Grid.Column="1" Text="{Binding AirplanesPath, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,8,0" VerticalAlignment="Center" Padding="4"/>
            <Button Grid.Column="2" Content="{helpers:Loc BtnUpdate}" Command="{Binding LoadLiveriesCommand}" Padding="12,4"/>
        </Grid>

        <!-- Corpo Principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Aeronaves e Liveries -->
            <GroupBox Header="{helpers:Loc TextInstalledLiveries}" Grid.Column="0" Margin="0,0,6,0" Foreground="White">
                <TreeView ItemsSource="{Binding AircraftGroups}" x:Name="TvAircrafts" SelectedItemChanged="TvAircrafts_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Liveries}">
                            <TextBlock Text="{Binding ModelName}" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Title}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TextureFolder}" Foreground="Gray" FontStyle="Italic"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </GroupBox>

            <!-- Painel Lateral: Preview, Edição, Remoção e Drop -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Pré-visualização da Livery -->
                <GroupBox Header="{helpers:Loc PreviewImage}" Grid.Row="0" Margin="0,0,0,8" Foreground="White">
                    <Border Height="150" Background="#0F172A" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <!-- Exibe a Imagem redimensionada proporcionalmente para caber 100% no quadro -->
                            <Image Source="{Binding SelectedLivery.ThumbnailPath}" 
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Fallback em texto quando não há imagem -->
                            <TextBlock Text="{helpers:Loc TextNoPreviewImage}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Foreground="#64748B" 
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLivery.ThumbnailPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- 2. Detalhes & Edição -->
                <GroupBox Header="{helpers:Loc TextSelectedLivery}" Grid.Row="1" Margin="0,0,0,8" Foreground="White">
                    <StackPanel Margin="6">
                        <TextBlock Text="{helpers:Loc TextInputTitleSimulator}" Margin="0,0,0,4" Foreground="White"/>
                        <TextBox Text="{Binding EditTitleText, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{helpers:Loc BtnSaveTitle}" Command="{Binding SaveTitleCommand}" Padding="10,4" Margin="0,0,6,0"/>
                            <Button Content="{helpers:Loc BtnRemoveLivery}" Command="{Binding DeleteSelectedLiveryCommand}" Background="#EF4444" Foreground="White" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Drop zone .PTP / .ZIP e Conversor -->
                <GroupBox Header="{helpers:Loc TextInstallConvertLivery}" Grid.Row="2" Foreground="White">
                    <Grid Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="6" Margin="8,8,8,4">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{helpers:Loc TextDragFilePtpZip}" TextAlignment="Center" FontWeight="SemiBold" Foreground="#475569"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Row="1" Content="{helpers:Loc BtnConvertPtpToZip}" Command="{Binding ConvertPtpToZipCommand}" 
                                Margin="8,4,8,8" Padding="10,6" Background="#0284C7" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Rodapé Status -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0" Background="#252526">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>